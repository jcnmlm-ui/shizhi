---
export interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;
---
<nav>
  <a href="/" class="nav-brand">時值 · <span>財務地圖</span></a>
  <div class="nav-links">
    <a href="/#features">功能</a>
    <a href="/#pricing">方案</a>
    <a href="/story">理財故事</a>
    <div class="nav-dropdown">
      <button class="nav-drop-trigger" aria-haspopup="true" aria-expanded="false">
        試算工具 <svg class="drop-arrow" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M1 1.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <div class="drop-menu" role="menu">
        <a href="/tools/postal-salary/" role="menuitem">
          <span class="drop-icon">📮</span>
          <span class="drop-text">
            <span class="drop-name">郵局薪資試算</span>
            <span class="drop-desc">薪級、年資、職涯總收入</span>
          </span>
        </a>
        <a href="/tools/labor-pension/" role="menuitem">
          <span class="drop-icon">🏦</span>
          <span class="drop-text">
            <span class="drop-name">勞退自提試算</span>
            <span class="drop-desc">勞保年金、勞退帳戶、節稅估算</span>
          </span>
        </a>
        <a href="/tools/tax-calc/" role="menuitem">
          <span class="drop-icon">🧾</span>
          <span class="drop-text">
            <span class="drop-name">綜所稅試算</span>
            <span class="drop-desc">113/114 年度、退稅 / 補稅估算</span>
          </span>
        </a>
      </div>
    </div>
    <a href="/#faq">FAQ</a>
    <a href="/app.html#login" class="nav-cta">免費開始使用 →</a>
  </div>
</nav>

<style>
nav {
  position: sticky; top: 0; z-index: 100;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px; height: 64px;
  background: rgba(246,242,233,.88); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}
.nav-brand {
  font-family: var(--font-display); font-weight: 600; font-size: 22px;
  color: var(--primary-2); letter-spacing: .4px;
}
.nav-brand span {
  font-size: 11px; font-family: var(--font-body); color: var(--muted);
  letter-spacing: 1px; margin-left: 8px; font-weight: 400;
}
.nav-links { display: flex; align-items: center; gap: 28px; font-size: 14px; color: var(--muted); }
.nav-links > a:hover { color: var(--primary); }
.nav-cta {
  background: var(--primary); color: #fff !important; border-radius: 9px;
  padding: 8px 18px; font-weight: 700; font-size: 14px; transition: .15s;
}
.nav-cta:hover { background: var(--primary-2) !important; }

/* ── Dropdown ── */
.nav-dropdown { position: relative; }
.nav-drop-trigger {
  display: flex; align-items: center; gap: 5px;
  font-size: 14px; color: var(--muted); font-family: var(--font-body);
  background: none; border: none; cursor: pointer; padding: 0;
  transition: color .15s;
}
.nav-drop-trigger:hover, .nav-dropdown:hover .nav-drop-trigger { color: var(--primary); }
.drop-arrow { width: 10px; height: 7px; transition: transform .2s; }
.nav-dropdown:hover .drop-arrow { transform: rotate(180deg); }

.drop-menu {
  position: absolute; top: calc(100% + 12px); left: 50%;
  transform: translateX(-50%);
  background: var(--surface, #FFFDF8);
  border: 1px solid var(--line); border-radius: 14px;
  box-shadow: 0 4px 6px rgba(27,38,32,.04), 0 16px 40px -12px rgba(27,38,32,.2);
  padding: 8px; min-width: 260px;
  opacity: 0; visibility: hidden; pointer-events: none;
  transform: translateX(-50%) translateY(-6px);
  transition: opacity .18s ease, transform .18s ease, visibility .18s;
}
.nav-dropdown:hover .drop-menu {
  opacity: 1; visibility: visible; pointer-events: auto;
  transform: translateX(-50%) translateY(0);
}
/* beak / arrow */
.drop-menu::before {
  content: '';
  position: absolute; top: -6px; left: 50%; transform: translateX(-50%);
  width: 12px; height: 6px;
  background: var(--surface, #FFFDF8);
  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  border-left: 1px solid var(--line); border-right: 1px solid var(--line);
}

.drop-menu a {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 12px; border-radius: 10px; color: var(--ink);
  transition: background .12s;
}
.drop-menu a:hover { background: var(--primary-soft, #E4EFE9); color: var(--primary-2); }
.drop-icon { font-size: 20px; flex: 0 0 auto; }
.drop-text { display: flex; flex-direction: column; gap: 2px; }
.drop-name { font-size: 14px; font-weight: 600; line-height: 1.3; }
.drop-desc { font-size: 11.5px; color: var(--muted); line-height: 1.4; }

@media (max-width: 800px) {
  nav { padding: 0 20px; }
  .nav-links { display: none; }
}
</style>
