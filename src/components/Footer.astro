</footer>

<style>
footer {
  background: var(--ink); color: rgba(255,255,255,.55); font-size: 13px;
  padding: 32px 40px;
  display: flex; justify-content: space-between; align-items: center;
  flex-wrap: wrap; gap: 16px;
}
footer .brand { color: rgba(255,255,255,.9); font-family: var(--font-display); font-size: 18px; font-weight: 500; }
footer a { color: rgba(255,255,255,.55); }
footer a:hover { color: rgba(255,255,255,.9); }
.footer-links { display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; }

.social-links { display: flex; gap: 10px; align-items: center; }
.social-links a,
.social-icon {
  display: flex; align-items: center; justify-content: center;
  width: 36px; height: 36px;
  border: 1px solid rgba(255,255,255,.22);
  border-radius: 50%;
  color: rgba(255,255,255,.7);
  transition: border-color .15s, color .15s, background .15s;
  flex-shrink: 0;
}
.social-links a:hover {
  border-color: rgba(255,255,255,.65);
  color: #fff;
  background: rgba(255,255,255,.08);
}
.social-placeholder {
  opacity: 0.35;
  cursor: default;
}

@media (max-width: 800px) {
  footer { flex-direction: column; text-align: center; padding: 32px 20px; gap: 20px; }
  .social-links { justify-content: center; }
}
</style>
